[Unit]
Description=Daaya Video Service
Requires=network.target
After=network.target
StartLimitIntervalSec=10

[Service]
Type=simple
Restart=always
RestartSec=1
User=daayavideo
Group=daayavideo
WorkingDirectory=/opt/daayavideoservice/
ExecStart=/opt/daayavideoservice/daayavideoserver
ExecStop=
# Restrict service capabilities
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=/var/daaya/videos /opt/daayavideoservice/certs
# Allow binding to privileged ports (80, 443)
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
Environment="DAAYA_PORT=443"
# Optional: comma-separated hostnames for Let's Encrypt
# Environment="DAAYA_HOSTNAMES=api.daaya.org,api2.daaya.org"
#StandardOutput=append:/opt/daayavideoservice/daayavideoserver.log
#StandardError=append:/opt/daayavideoservice/daayavideoserver.log

[Install]
WantedBy=multi-user.target
